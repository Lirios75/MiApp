# Nombres de variables — SIN valores reales (62-PUBLICACION-SEGURA-Y-CONTINUA.md §3).
# Cada valor se pega directamente en el dashboard del proveedor (Vercel/Supabase/Resend/
# Hotmart), NUNCA en el chat ni en este archivo.

# URL pública final de la app (dominio propio en producción; *.vercel.app mientras tanto)
NEXT_PUBLIC_SITE_URL=

# Supabase — URL y clave publicable son PÚBLICAS por diseño (solo son seguras con RLS real)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase — clave secreta de servidor (SOLO en Vercel, nunca con prefijo NEXT_PUBLIC_)
SUPABASE_SECRET_KEY=

# Resend (emails transaccionales) — secreta
RESEND_API_KEY=

# Hotmart — firma del webhook que valida cada compra/cancelación — secreta
HOTMART_HOTTOK=
